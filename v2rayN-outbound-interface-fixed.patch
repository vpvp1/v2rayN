+    private void ApplyOutboundSendThroughInterface()
+    {
+        var outboundInterface = _config.CoreBasicItem.OutboundInterface?.TrimEx();
+        if (outboundInterface.IsNullOrEmpty())
+        {
+            return;
+        }
+
+        // Set sendThrough on all applicable outbounds
