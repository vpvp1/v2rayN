+    /// Returns whether the given profile is included in the Auto Switch rotation.
+    /// </summary>
+    public bool GetAutoSwitchEnabled(string indexId)
+    {
+        var profileEx = _lstProfileEx.FirstOrDefault(t => t.IndexId == indexId);
