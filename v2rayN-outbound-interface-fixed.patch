From 875e127423d54811575901545b8d5c87550649a1 Mon Sep 17 00:00:00 2001
From: v2rayN Dev <dev@v2rayn.local>
Date: Mon, 15 Jun 2026 08:51:53 +0000
Subject: [PATCH 4/4] fix: Order sort resets on selection/refresh

Track active sort column+direction in _activeSortColumn/_activeSortAscending.
After every RefreshServersBiz reload, re-apply ApplyAutoSwitchOrderSort so
the displayed order is preserved when the user clicks a row or any other
event triggers a list refresh.
---
 .../ViewModels/ProfilesViewModel.cs           | 63 ++++++++++++++-----
 1 file changed, 48 insertions(+), 15 deletions(-)

diff --git a/v2rayN/ServiceLib/ViewModels/ProfilesViewModel.cs b/v2rayN/ServiceLib/ViewModels/ProfilesViewModel.cs
index ef0a7123..ddbeb9a9 100644
--- a/v2rayN/ServiceLib/ViewModels/ProfilesViewModel.cs
+++ b/v2rayN/ServiceLib/ViewModels/ProfilesViewModel.cs
@@ -10,6 +10,10 @@ public class ProfilesViewModel : MyReactiveObject
     private SpeedtestService? _speedtestService;
     private string? _pendingSelectIndexId;
 
+    // Tracks the last column the user sorted by, so RefreshServersBiz can re-apply it.
+    private string? _activeSortColumn;
+    private bool _activeSortAscending = true;
+
     /// <summary>
     /// Guards against re-entrant calls to AutoSwitchToggled/AutoSwitchOrderChanged
     /// while in-place syncing AutoSwitchEnabled/AutoSwitchOrder values across
@@ -385,6 +389,20 @@ public class ProfilesViewModel : MyReactiveObject
         ProfileItems.Clear();
         ProfileItems.AddRange(lstModel);
 
+        // Re-apply the last active sort so selection/refresh doesn't reset order
+        if (!_activeSortColumn.IsNullOrEmpty())
+        {
+            if (_activeSortColumn == nameof(ProfileItemModel.AutoSwitchOrder))
+            {
+                // _activeSortAscending already flipped after last click, so the
+                // direction stored is what the *next* click would use. We want to
+                // re-display the *current* sort, which is the opposite.
+                ApplyAutoSwitchOrderSort(!_activeSortAscending);
+            }
+            // For DB-backed sorts the order comes from the DB itself, so no extra
+            // in-memory sort is needed here; the list is already ordered correctly.
+        }
+
         foreach (var profileItem in lstModel)
         {
             SubscribeAutoSwitchColumnChanges(profileItem);
@@ -824,23 +842,12 @@ public class ProfilesViewModel : MyReactiveObject
             _dicHeaderSort.TryAdd(colName, true);
             _dicHeaderSort.TryGetValue(colName, out var asc);
 
-            var sorted = asc
-                ? ProfileItems
-                    .OrderBy(x => x.AutoSwitchOrder == 0 ? 1 : 0)
-                    .ThenBy(x => x.AutoSwitchOrder == 0 ? 0 : x.AutoSwitchOrder)
-                    .ToList()
-                : ProfileItems
-                    .OrderBy(x => x.AutoSwitchOrder == 0 ? 1 : 0)
-                    .ThenByDescending(x => x.AutoSwitchOrder == 0 ? 0 : x.AutoSwitchOrder)
-                    .ToList();
+            ApplyAutoSwitchOrderSort(asc);
 
+            // Persist sort direction and remember active column
             _dicHeaderSort[colName] = !asc;
-
-            using (ProfileItems.SuspendNotifications())
-            {
-                ProfileItems.Clear();
-                ProfileItems.AddRange(sorted);
-            }
+            _activeSortColumn = colName;
+            _activeSortAscending = !asc;
             return;
         }
 
@@ -851,9 +858,35 @@ public class ProfilesViewModel : MyReactiveObject
             return;
         }
         _dicHeaderSort[colName] = !ascDefault;
+        _activeSortColumn = colName;
+        _activeSortAscending = !ascDefault;
         await RefreshServers();
     }
 
+    /// <summary>
+    /// Applies the AutoSwitchOrder sort to ProfileItems in-place (zeros last).
+    /// ascending:  1, 2, 3 … N, 0, 0, 0
+    /// descending: N, … 2, 1, 0, 0, 0
+    /// </summary>
+    private void ApplyAutoSwitchOrderSort(bool ascending)
+    {
+        var sorted = ascending
+            ? ProfileItems
+                .OrderBy(x => x.AutoSwitchOrder == 0 ? 1 : 0)
+                .ThenBy(x => x.AutoSwitchOrder == 0 ? 0 : x.AutoSwitchOrder)
+                .ToList()
+            : ProfileItems
+                .OrderBy(x => x.AutoSwitchOrder == 0 ? 1 : 0)
+                .ThenByDescending(x => x.AutoSwitchOrder == 0 ? 0 : x.AutoSwitchOrder)
+                .ToList();
+
+        using (ProfileItems.SuspendNotifications())
+        {
+            ProfileItems.Clear();
+            ProfileItems.AddRange(sorted);
+        }
+    }
+
     public async Task RemoveInvalidServerResult()
     {
         var count = await ConfigHandler.RemoveInvalidServerResult(_config, _config.SubIndexId);
