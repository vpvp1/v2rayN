+    private void LstProfiles_CellEditEnding(object? sender, DataGridCellEditEndingEventArgs e)
+    {
+        if (e.EditAction != DataGridEditAction.Commit)
+        {
+            return;
+        }
+        if (e.Row.Item is not ProfileItemModel item)
+        {
+            return;
+        }
+
+        var columnName = (e.Column as DataGridBoundColumn)?.Binding is System.Windows.Data.Binding binding
+            ? binding.Path.Path
+            : null;
+
+        if (columnName is not ("AutoSwitchEnabled" or "AutoSwitchOrder"))
+        {
+            return;
+        }
+
+        // Defer until after the binding has written the new value back to the
+        // ViewModel item, then persist the change.
+        Dispatcher.BeginInvoke(async () =>
+        {
+            if (columnName == "AutoSwitchEnabled")
+            {
+                await ViewModel?.AutoSwitchToggled(item);
+            }
+            else
+            {
+                await ViewModel?.AutoSwitchOrderChanged(item);
+            }
+        }, DispatcherPriority.Background);
+    }
