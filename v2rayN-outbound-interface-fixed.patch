From c4dcc0e32f94dff84e74f3a541556bffc717c63e Mon Sep 17 00:00:00 2001
From: v2rayN Dev <dev@v2rayn.local>
Date: Mon, 15 Jun 2026 08:08:18 +0000
Subject: [PATCH 2/4] fix: replace Tag DP with DataGridColumnEx attached
 property

DataGridTemplateColumn inherits from DependencyObject but not
FrameworkElement, so it has no Tag/Name dependency property.
Introduce DataGridColumnEx.ExName as a proper attached DP that works
on any DataGridColumn subclass, and update XAML + code-behind to use it.
---
 v2rayN/v2rayN/Base/DataGridColumnEx.cs   | 25 ++++++++++++++++++++++++
 v2rayN/v2rayN/Views/ProfilesView.xaml    |  6 +++---
 v2rayN/v2rayN/Views/ProfilesView.xaml.cs |  8 ++++----
 3 files changed, 32 insertions(+), 7 deletions(-)
 create mode 100644 v2rayN/v2rayN/Base/DataGridColumnEx.cs

diff --git a/v2rayN/v2rayN/Base/DataGridColumnEx.cs b/v2rayN/v2rayN/Base/DataGridColumnEx.cs
new file mode 100644
index 00000000..32a8a924
--- /dev/null
+++ b/v2rayN/v2rayN/Base/DataGridColumnEx.cs
@@ -0,0 +1,25 @@
+using System.Windows;
+using System.Windows.Controls;
+
+namespace v2rayN.Base;
+
+/// <summary>
+/// Attached properties that extend any <see cref="DataGridColumn"/> subclass,
+/// including <see cref="DataGridTemplateColumn"/> which does not inherit from
+/// <see cref="FrameworkElement"/> and therefore has no Tag/Name DP of its own.
+/// </summary>
+public static class DataGridColumnEx
+{
+    public static readonly DependencyProperty ExNameProperty =
+        DependencyProperty.RegisterAttached(
+            "ExName",
+            typeof(string),
+            typeof(DataGridColumnEx),
+            new PropertyMetadata(string.Empty));
+
+    public static string GetExName(DependencyObject obj) =>
+        (string)obj.GetValue(ExNameProperty);
+
+    public static void SetExName(DependencyObject obj, string value) =>
+        obj.SetValue(ExNameProperty, value);
+}
